          "request": {
            "name": "Get report data",
            "description": {
              "content": "Returns real-time report data (paginated).\nGood for small reports (<10K rows) because no preparation step is required. Usable for bigger reports too with the risk of missing or ghost rows due to concurrent updates going in the same time.",
