        {
          "id": "5d586210-5e80-49f3-a14e-9bc0e9891857",
          "name": "Submit a marketplace action (e.g. withdraw offer or authorization)",
          "request": {
            "name": "Submit a marketplace action (e.g. withdraw offer or authorization)",
            "description": {
              "content": "Initiates an asynchronous marketplace action on a WorkSpan offer. The request is validated synchronously — if all checks pass, an action_id is returned immediately with status IN_PROGRESS and the operation runs in the background. Poll GET /actions/{action_id} for the final status.\n\nValidation checks performed before the action is accepted (in order):\n1. Application User must have the MARKETPLACE_ACTIONS security profile.\n2. action_type must be 'withdraw'.\n3. object_type must be 'ws-offer'.\n4. marketplace_type must be 'aws', 'azure', or 'gcp'.\n5. object_id must resolve to an existing WorkSpan offer belonging to the caller's company.\n6. No existing IN_PROGRESS action for the same object_id and action_type.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "actions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action_type\": \"withdraw\",\n  \"object_type\": \"ws-offer\",\n  \"marketplace_type\": \"aws\",\n  \"object_id\": \"offer-1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "2c31f76f-beaa-42bb-b56a-a94dc5483546",
              "name": "Action accepted and running asynchronously. status is always IN_PROGRESS in this response. Use the returned action_id to poll GET /actions/{action_id} for the final result.",
