          "name": "Get marketplace usage upload status",
          "request": {
            "name": "Get marketplace usage upload status",
            "description": {
              "content": "Retrieves the status of marketplace usage upload by execution_id. Returns a list of projects associated with the execution_id, including their workflow status, project name, external ID, and project ID.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "usage",
                "status"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "execution_id",
                  "description": "(Required) The execution ID to search for. This is the execution ID returned from the usage upload endpoint."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
