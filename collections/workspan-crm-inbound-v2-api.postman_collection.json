          "id": "81db6930-ceff-453d-800c-53000568c255",
          "name": "Load AWS Marketplace Authorization to WorkSpan",
          "request": {
            "name": "Load AWS Marketplace Authorization to WorkSpan",
            "description": {
              "content": "Load AWS marketplace authorization objects to WorkSpan. Creates or updates marketplace authorizations with flexible pricing and payment configurations.\n\nREQUEST MODEL: AwsMarketplaceAuthorizationInboundRequest\n\nNESTED MODELS (in data payload):\n- pricing_terms (array) → Dimension model\n- payment_schedules (array) → PaymentScheduleTerms model\n\nFILE UPLOADS (form fields):\n- customer_eula_file (optional): Customer EULA document\n- reseller_eula_file (optional): Reseller EULA document\n\nDATA FORMAT: Send AwsMarketplaceAuthorizationInboundRequest as JSON in the 'data' form field.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "crm_inbound_v2"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "integration_id",
                  "description": "(Required) Integration ID of CRM integration that is configured in WorkSpan App."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              }
            ],
            "method": "POST",
            "auth": null,
